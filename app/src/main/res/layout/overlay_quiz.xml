<?xml version="1.0" encoding="utf-8"?>
<!-- Экран с примерами (вертикальная ориентация). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rest_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/quiz_cat"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:contentDescription="@null"
            android:src="@drawable/cat_neutral" />

        <TextView
            android:id="@+id/quiz_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/rest_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quiz_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="44dp"
            android:textColor="@color/rest_text_soft"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quiz_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rest_accent"
            android:textSize="26sp" />

        <LinearLayout
            android:id="@+id/quiz_examples"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/quiz_keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <include layout="@layout/quiz_parent" />
    </LinearLayout>
</ScrollView>
