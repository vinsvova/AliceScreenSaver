<?xml version="1.0" encoding="utf-8"?>
<!-- Экран заданий (вертикальная ориентация). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rest_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/quiz_cat"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@null"
            android:src="@drawable/cat_neutral" />

        <TextView
            android:id="@+id/quiz_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/rest_text_soft"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/quiz_feedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minHeight="40dp"
            android:textColor="@color/rest_text_soft"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quiz_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/rest_accent"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/quiz_task_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quiz_task"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:maxWidth="640dp"
                android:textColor="@color/rest_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quiz_answer"
                android:layout_width="160dp"
                android:layout_height="88dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/rest_text"
                android:textSize="52sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quiz_keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

        <include layout="@layout/quiz_parent" />
    </LinearLayout>
</ScrollView>
