<?xml version="1.0" encoding="utf-8"?>
<!-- Вход для родителей на экране примеров: пропустить примеры по PIN. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/parent_panel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:background="@drawable/rest_card_bg"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parent_pin_label"
            android:textColor="@color/rest_text"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/parent_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/rest_text_soft"
            android:importantForAutofill="no"
            android:inputType="numberPassword"
            android:maxLength="12"
            android:textColor="@color/rest_text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/parent_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/rest_error"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/parent_cancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:textColor="@color/rest_text_soft" />

            <Button
                android:id="@+id/parent_unlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/rest_accent"
                android:text="@string/skip_quiz"
                android:textColor="@color/rest_background" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/parent_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:alpha="0.6"
        android:text="@string/for_parents"
        android:textColor="@color/rest_text_soft" />
</merge>
