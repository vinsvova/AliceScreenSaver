<?xml version="1.0" encoding="utf-8"?>
<!-- Экран заданий (горизонтальная ориентация): слева котик и задание, справа клавиатура. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rest_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/quiz_cat"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="@null"
                    android:src="@drawable/cat_neutral" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/quiz_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rest_text_soft"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/quiz_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/rest_accent"
                        android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/quiz_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="38dp"
                android:textColor="@color/rest_text_soft"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/quiz_task_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/quiz_task"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:maxWidth="600dp"
                    android:textColor="@color/rest_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quiz_answer"
                    android:layout_width="160dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="@color/rest_text"
                    android:textSize="50sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <include layout="@layout/quiz_parent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quiz_keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
