<?xml version="1.0" encoding="utf-8"?>
<!-- Экран с примерами (горизонтальная ориентация): слева котик и примеры, справа клавиатура. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rest_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/quiz_cat"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:contentDescription="@null"
                android:src="@drawable/cat_neutral" />

            <TextView
                android:id="@+id/quiz_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/rest_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quiz_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="40dp"
                android:textColor="@color/rest_text_soft"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quiz_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/rest_accent"
                android:textSize="24sp" />

            <LinearLayout
                android:id="@+id/quiz_examples"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <include layout="@layout/quiz_parent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quiz_keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
